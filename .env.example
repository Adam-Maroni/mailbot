# --- Discord credentials (Hermes container reads these) ---
#
# Created in Discord Developer Portal under your app's Bot tab.
# Privileged intents MUST be enabled in the portal: MESSAGE_CONTENT,
# Server Members. Hermes does NOT declare these in config.yaml — they're
# auto-configured by the gateway and must be portal-enabled to take effect.
DISCORD_BOT_TOKEN=
# Discord application ID (public, non-secret) from Portal → General Information.
# Consumed by scripts/register_discord_commands.py (Story 9.5.1) for one-shot
# slash-command registration to the Discord Developer Portal. Not read by
# Hermes at runtime. See docs/runbooks/discord-slash-registration.md.
DISCORD_APPLICATION_ID=
# Comma-separated Discord user IDs allowed to interact with the bot. Required
# for security — without it, the bot ignores every message. Adam's deploy:
# set to Adam's Discord user ID (find via Discord's developer mode: right-click
# your avatar → Copy ID).
DISCORD_ALLOWED_USERS=
# Channel ID (DM or text channel) where Hermes posts proactive messages
# (08:00 digest, urgent notifications, etc.). Right-click the channel → Copy ID.
DISCORD_HOME_CHANNEL=

# --- Hermes container UID/GID alignment (Linux VPS deploy) ---
#
# The Hermes Docker image's cont-init hook chowns /opt/data to the supervised
# `hermes` user (default UID 10000). When ./hermes-config/ is bind-mounted in,
# the host-side ownership flips between container restarts. On a native Linux
# VPS, set these to match the host user that owns the bind-mount directory
# (e.g., on Hostinger after Story 6-7's setup_vps.sh runs:
#   PUID=$(id -u mailbot) PGID=$(id -g mailbot)).
# Leave empty on Docker Desktop (macOS / Windows) — the image's defaults work.
# See docs/external/hermes-agent/RECONCILIATION-NOTES.md §2.5.
PUID=
PGID=

# Anthropic API key.
#
# Per Rule F.1, the agent never holds this key under normal operation — only
# mailbot-api's process reads it. The documented exception is Hermes's
# NFR-OPS-6 emergency fallback: when mailbot-api is hard-down for > 10
# minutes, Hermes uses this key to talk directly to api.anthropic.com,
# bypassing the Router's cost discipline by design.
#
# Setup: at first deploy, exec into mailbot-hermes and run
# `hermes fallback add anthropic claude-opus-4-7` interactively. The fallback
# chain is NOT config-YAML-driven in real Hermes (Story 6-0 finding); it's
# managed via the `hermes fallback` CLI. The Hermes container's env block
# carries ANTHROPIC_API_KEY ONLY to enable that fallback path once configured.
ANTHROPIC_API_KEY=

# Microsoft Graph OAuth (Outlook delegated permissions; refresh token is the bootstrap seed for oauth_state)
OUTLOOK_CLIENT_ID=
# Confidential-client deployments only ("Web" platform). Public-client (recommended) deployments
# MUST OMIT this OR set OUTLOOK_PUBLIC_CLIENT=true (Story 6-16 F25 fix — closes silent AADSTS90023
# on every refresh when secret is sent against a public-client Entra app). See docs/entra-app-registration.md.
OUTLOOK_CLIENT_SECRET=
OUTLOOK_TENANT_ID=
# Obtained via scripts/mint_refresh_token.py — see docs/entra-app-registration.md
OUTLOOK_REFRESH_TOKEN=
# Story 6-16: set to true for public-client Entra apps (Mobile and desktop apps platform —
# the recommended setup for personal MS accounts). When true, OUTLOOK_CLIENT_SECRET is
# suppressed at token-exchange time regardless of its env value (rollback-friendly).
OUTLOOK_PUBLIC_CLIENT=

# Local SQLite database path (e.g., /data/mailbot.db inside container; ./mailbot.db for dev)
MAILBOT_DB_PATH=

# Router policy YAML path (default /app/router/policy.yaml inside container; ./router/policy.yaml for dev)
MAILBOT_POLICY_PATH=

# Ollama service URL (http://ollama:11434 inside compose network; http://localhost:11434 for dev)
OLLAMA_URL=

# Per-process Router auth (mailbot-api internal; rotates independently of cloud keys).
# Hermes propagates the same value as `Authorization: Bearer <token>` when calling
# mailbot-api's /v1/chat/completions per Story 5-4 AC-1 (provider.api_key).
MAILBOT_ROUTER_KEY=
