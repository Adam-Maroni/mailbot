# Database files (broad wildcard per AC-1; more specific patterns above)
*.db

# Hermes runtime artifacts written to /opt/data (Story 5-4 Phase 3.5 fix).
# Hermes treats /opt/data as its HOME dir and writes cron state + other
# runtime artifacts. The persona docs + config.yaml are Adam-owned (kept
# tracked); anything else Hermes writes here is runtime state.
hermes-config/cron/
hermes-config/data/
hermes-config/state/
hermes-config/logs/
hermes-config/.hermes/

# Story 9-1: policy.user-overrides.yaml is operator-state (written by Story 9-4
# set_model_persistent), NOT source-of-truth. The .example sibling IS tracked
# as a discoverable template.
router/policy.user-overrides.yaml
!router/policy.user-overrides.yaml.example

# Story 9-5: evals/email_corpus_v1.jsonl is privacy-sensitive operator-state
# (Adam's real inbox content + Adam-labeled ground truth). The .example sibling
# IS tracked as a discoverable template; the 5-item canary fixture IS tracked
# for CI use (PII-free by construction per AC-7).
evals/email_corpus_v1.jsonl
!evals/email_corpus_v1.jsonl.example

# Story 9-5 AC-11: evals/anchors/*.jsonl carry real model_output examples
# Adam authored against production-sampled corpus rows. Same privacy-treatment
# as the corpus itself: gitignored, VPS-only, bind-mounted. The .example
# siblings + VERSION file ARE tracked.
evals/anchors/*.jsonl
!evals/anchors/*.jsonl.example

# Story 9-5 AC-15: evals/_labeling/ holds the CSV worksheets the AC-15
# co-pilot session writes + Adam edits. Privacy-sensitive (worksheets carry
# raw_body during labeling, and prefill-output captures may carry real model
# responses). Worksheets are scratch state; no .example carve-out.
evals/_labeling/

# Story 9-11: evals/anchor_baselines/*.json carry per-anchor model scores
# produced by the cross-evaluator audit. These are operator-state (frozen
# baselines + failed-calibration artifacts). The .gitkeep + .example
# siblings ARE tracked so the directory exists and a discoverable template
# lives in-tree.
evals/anchor_baselines/*.json
!evals/anchor_baselines/*.example
